{
    "name": "kajalpandya/generate_laravel_crud",
    "description": "Laravel 13 admin panel you publish into your app and own: users, blog, FAQs, testimonials, pages, inquiries and site settings.",
    "keywords": [
        "laravel",
        "laravel-13",
        "admin",
        "admin-panel",
        "laravel-admin",
        "dashboard",
        "backend",
        "crud",
        "scaffolding",
        "generator",
        "blog",
        "cms",
        "starter-kit"
    ],
    "homepage": "https://github.com/kajal98/generate_crud",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajal",
            "email": "kjlkajal98@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/kajal98/generate_crud/issues",
        "source": "https://github.com/kajal98/generate_crud"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "anahkiasen/former": "^5.2",
        "cviebrock/eloquent-sluggable": "^13.0",
        "intervention/image": "^4.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "KajalPandya\\LaravelCrud\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "KajalPandya\\LaravelCrud\\CrudServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "livewire/livewire": "Required for the Livewire stack (crud:install livewire)"
    },
    "autoload-dev": {
        "psr-4": {
            "KajalPandya\\LaravelCrud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
